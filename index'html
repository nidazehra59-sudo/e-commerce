DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lumière Boutique</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#F8F6F9;--card:#fff;--ink:#3A3341;--mute:#7C7385;--rose:#C9919F;--rose-d:#B27685;--sage:#DDE7DB;--mist:#E8E3F0;--line:#ECE7F0;--r:18px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Nunito Sans',sans-serif;background:var(--bg);color:var(--ink);line-height:1.65}
h1,h2,h3{font-family:'Cormorant Garamond',serif;font-weight:600;line-height:1.15}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer;border:0}
:focus-visible{outline:2px solid var(--rose);outline-offset:2px}
.wrap{max-width:1100px;margin:0 auto;padding:0 22px}
section{padding:84px 0}
.btn{background:var(--rose);color:#fff;padding:12px 26px;border-radius:40px;font-weight:700;transition:.2s}
.btn:hover{background:var(--rose-d)}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--rose)}
.btn.sm{padding:7px 16px;font-size:.85rem}
.btn.danger{background:#D98C8C}
header{position:sticky;top:0;z-index:20;background:rgba(248,246,249,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font-family:'Cormorant Garamond',serif;font-size:1.7rem;font-weight:700}
.links{display:flex;gap:28px;align-items:center}
.links a{color:var(--mute);font-weight:600}.links a:hover{color:var(--ink)}
.cartbtn{background:var(--mist);color:var(--ink);padding:8px 18px;border-radius:30px;font-weight:700}
.hero{background:linear-gradient(135deg,var(--mist),var(--sage) 120%);padding:110px 0}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}
.hero h1{font-size:clamp(2.6rem,6vw,4.4rem);margin-bottom:18px}
.hero p{color:var(--mute);font-size:1.1rem;max-width:460px;margin-bottom:28px}
.ph{background:linear-gradient(135deg,#EFE9F4,#E3EBE1);display:flex;align-items:center;justify-content:center;color:#A99FB3;font-size:.9rem;overflow:hidden}
.ph img{width:100%;height:100%;object-fit:cover}
.hero .ph{aspect-ratio:4/3;border-radius:28px;box-shadow:0 20px 50px rgba(90,70,110,.18)}
.title{text-align:center;margin-bottom:44px}
.title h2{font-size:2.6rem}.title p{color:var(--mute)}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}
.about .ph{aspect-ratio:4/3;border-radius:28px;box-shadow:0 20px 50px rgba(90,70,110,.14)}
.about p{color:var(--mute);margin-top:14px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:26px}
.card{background:var(--card);border-radius:var(--r);overflow:hidden;box-shadow:0 8px 30px rgba(90,70,110,.07);display:flex;flex-direction:column}
.card .ph{aspect-ratio:1}
.card .b{padding:18px 20px 22px;display:flex;flex-direction:column;gap:6px;flex:1}
.card h3{font-size:1.5rem}.card .d{color:var(--mute);font-size:.92rem;flex:1}
.row{display:flex;align-items:center;justify-content:space-between;margin-top:10px;gap:10px}
.price{font-weight:700;color:var(--rose-d);font-size:1.1rem}
.out{font-size:.8rem;color:#B07070;font-weight:700}
.contact{background:var(--mist)}
.contact .wrap{max-width:620px}
form.f{display:grid;gap:14px}
input,textarea,select{width:100%;padding:13px 16px;border:1.5px solid var(--line);border-radius:12px;font:inherit;background:#fff;color:var(--ink)}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--rose)}
footer{background:var(--ink);color:#CFC8D6;padding:44px 0;text-align:center;font-size:.92rem}
footer a{color:#fff;margin:0 10px}
.ov{position:fixed;inset:0;background:rgba(58,51,65,.4);display:none;z-index:40;justify-content:flex-end}
.ov.on{display:flex}
.drawer{background:#fff;width:min(420px,100%);height:100%;padding:26px;overflow:auto;display:flex;flex-direction:column;gap:14px}
.ci{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.q button{background:var(--mist);width:26px;height:26px;border-radius:50%}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:12px 22px;border-radius:30px;z-index:90;display:none}
/* admin */
#admin{display:none;min-height:100vh;background:var(--bg)}
.atop{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:#fff;border-bottom:1px solid var(--line)}
.tabs{display:flex;gap:10px;margin:24px 0}
.tabs button{padding:9px 22px;border-radius:30px;background:var(--mist);font-weight:700}
.tabs button.on{background:var(--rose);color:#fff}
.tbl{background:#fff;border-radius:var(--r);overflow:auto;box-shadow:0 8px 30px rgba(90,70,110,.06)}
table{width:100%;border-collapse:collapse;min-width:640px}
th,td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--line);font-size:.92rem;vertical-align:middle}
th{color:var(--mute);font-weight:700}
td img,.thumb{width:48px;height:48px;border-radius:10px;object-fit:cover;background:var(--mist)}
.modal{background:#fff;margin:auto;padding:26px;border-radius:var(--r);width:min(480px,94%);max-height:92vh;overflow:auto;display:grid;gap:12px}
.login{max-width:360px;margin:14vh auto;background:#fff;padding:30px;border-radius:var(--r);display:grid;gap:14px;text-align:center}
@media(max-width:760px){.hero .wrap,.about .wrap{grid-template-columns:1fr}.links a:not(.cartbtn){display:none}section{padding:60px 0}.hero{padding:60px 0}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

/* ---- Pro polish ---- */
body{-webkit-font-smoothing:antialiased;letter-spacing:.005em}
section{padding:96px 0}
header{transition:box-shadow .3s}header.sc{box-shadow:0 6px 24px rgba(90,70,110,.08)}
.logo{display:flex;align-items:center;gap:10px}
.mark{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--rose),#B9A6D3);color:#fff;display:grid;place-items:center;font-size:1.05rem}
.links a{position:relative;font-size:.95rem}
.links a:not(.cartbtn)::after{content:"";position:absolute;left:0;bottom:-6px;width:0;height:2px;background:var(--rose);transition:.25s}
.links a:not(.cartbtn):hover::after,.links a.act::after{width:100%}
.links a.act{color:var(--ink)}
.btn{box-shadow:0 8px 20px rgba(201,145,159,.35);padding:13px 30px;letter-spacing:.02em}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{box-shadow:none}.btn.sm{box-shadow:none}
.eyebrow{display:inline-block;font-size:.78rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--rose-d);background:rgba(255,255,255,.7);padding:6px 14px;border-radius:30px;margin-bottom:18px}
.hero{position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;width:420px;height:420px;border-radius:50%;background:rgba(255,255,255,.45);top:-140px;right:-100px}
.hero .wrap{position:relative}
.hero h1{letter-spacing:-.01em}
.cta{display:flex;gap:14px;flex-wrap:wrap}
.checks{display:flex;gap:22px;flex-wrap:wrap;margin-top:30px;font-size:.9rem;color:var(--mute);font-weight:600}
.checks span::before{content:"\2713";color:var(--rose-d);margin-right:7px;font-weight:700}
.trust{background:#fff;border-bottom:1px solid var(--line)}
.trust .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding-top:28px;padding-bottom:28px}
.ti{display:flex;gap:12px;align-items:center}
.ti i{font-style:normal;width:44px;height:44px;border-radius:14px;background:var(--mist);display:grid;place-items:center;font-size:1.2rem;flex-shrink:0}
.ti b{display:block;font-size:.95rem;line-height:1.3}.ti small{color:var(--mute);font-size:.82rem}
.title h2,.about h2{letter-spacing:-.01em}
.title .eyebrow{background:var(--mist)}
.feat{list-style:none;display:grid;gap:12px;margin-top:22px}
.feat li{display:flex;gap:12px;align-items:flex-start;color:var(--ink);font-weight:600;font-size:.95rem}
.feat li::before{content:"\2713";flex-shrink:0;width:24px;height:24px;border-radius:50%;background:var(--sage);color:#5E7A5C;display:grid;place-items:center;font-size:.8rem;margin-top:2px}
.card{position:relative;transition:transform .3s,box-shadow .3s;border:1px solid var(--line)}
.card:hover{transform:translateY(-6px);box-shadow:0 18px 44px rgba(90,70,110,.14)}
.card .ph{overflow:hidden}.card .ph img{transition:transform .5s}.card:hover .ph img{transform:scale(1.05)}
.badge{position:absolute;top:14px;left:14px;z-index:2;background:#fff;color:var(--rose-d);font-size:.74rem;font-weight:700;padding:5px 12px;border-radius:20px;box-shadow:0 4px 12px rgba(0,0,0,.08)}
.badge.so{background:var(--ink);color:#fff}
.sk{background:linear-gradient(100deg,#EFEAF3 30%,#F8F6F9 50%,#EFEAF3 70%);background-size:200% 100%;animation:sh 1.4s infinite;border-radius:var(--r);aspect-ratio:3/4}
@keyframes sh{to{background-position:-200% 0}}
.contact .wrap{max-width:1000px}
.cgrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:start}
.cinfo{display:grid;gap:14px}
.ci2{background:#fff;border-radius:var(--r);padding:20px 22px;display:flex;gap:16px;align-items:center;box-shadow:0 6px 20px rgba(90,70,110,.05)}
.ci2 i{font-style:normal;font-size:1.3rem;width:46px;height:46px;border-radius:14px;background:var(--sage);display:grid;place-items:center;flex-shrink:0}
.ci2 small{color:var(--mute);display:block;font-size:.8rem}
.cform{background:#fff;border-radius:24px;padding:30px;box-shadow:0 12px 36px rgba(90,70,110,.08)}
footer{background:#2F2937;padding:64px 0 28px;text-align:left}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding-bottom:36px;border-bottom:1px solid rgba(255,255,255,.1)}
footer h4{color:#fff;font-family:'Cormorant Garamond',serif;font-size:1.3rem;margin-bottom:14px}
footer p{color:#B9B0C2;max-width:320px}
footer a{display:block;margin:0 0 9px;color:#CFC8D6;transition:.2s}footer a:hover{color:#fff;padding-left:4px}
.fbot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;padding-top:22px;font-size:.85rem;color:#988FA3}
.fbot a{display:inline;margin:0;opacity:.6}
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s,transform .7s}.rv.in{opacity:1;transform:none}
@media(max-width:860px){.trust .wrap{grid-template-columns:1fr 1fr}.cgrid,.fgrid{grid-template-columns:1fr}.hero .ph{order:-1}}
@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none}.sk{animation:none}}
</style>
</head>
<body>

<!-- ============ STORE ============ -->
<div id="store">
<header><div class="wrap nav">
  <a href="#home" class="logo"><span class="mark">L</span>Lumière</a>
  <nav class="links"><a href="#home">Home</a><a href="#about">About</a><a href="#products">Products</a><a href="#contact">Contact</a>
  <button class="cartbtn" id="cartOpen">Cart (<span id="cc">0</span>)</button></nav>
</div></header>

<section class="hero" id="home"><div class="wrap">
  <div><span class="eyebrow">New collection</span><h1>Soft things, chosen with care</h1><p>Thoughtfully made pieces for your everyday moments. Browse our collection and order in a minute.</p>
  <div class="cta"><a href="#products" class="btn">Shop products</a><a href="#about" class="btn ghost">Our story</a></div>
  <div class="checks"><span>Cash on delivery</span><span>Quality checked</span><span>Fast dispatch</span></div></div>
  <div class="ph"><img src="data:image/jpeg;base64," alt="Lumière store interior"></div>
</div></section>

<div class="trust"><div class="wrap">
  <div class="ti"><i>&#128666;</i><div><b>Fast delivery</b><small>Across the country</small></div></div>
  <div class="ti"><i>&#128181;</i><div><b>Cash on delivery</b><small>Pay when it arrives</small></div></div>
  <div class="ti"><i>&#10024;</i><div><b>Quality checked</b><small>Every single piece</small></div></div>
  <div class="ti"><i>&#128172;</i><div><b>Friendly support</b><small>We confirm by call</small></div></div>
</div></div>

<section class="about" id="about"><div class="wrap">
  <div class="ph"><img src="data:image/jpeg;base64," alt="Leather mobile cover"></div>
  <div><span class="eyebrow">About us</span><h2 style="font-size:2.7rem">Made with care, delivered with a smile</h2>
  <p>We are a small team that cares about quality and simple shopping. Every product is picked by hand, checked before it ships, and packed with attention.</p>
  <ul class="feat"><li>Hand-picked products from trusted makers</li><li>Simple ordering with cash on delivery</li><li>Real people confirm every order</li></ul></div>
</div></section>

<section id="products"><div class="wrap">
  <div class="title"><span class="eyebrow">Shop</span><h2>Our products</h2><p>Fresh stock, updated live.</p></div>
  <div class="grid" id="grid"></div>
</div></section>

<section class="contact" id="contact"><div class="wrap">
  <div class="title"><span class="eyebrow">Contact</span><h2>Get in touch</h2><p>Questions about an order? We are happy to help.</p></div>
  <div class="cgrid">
    <div class="cinfo">
      <div class="ci2"><i>&#128222;</i><div><small>Phone</small><b>+92 300 0000000</b></div></div>
      <div class="ci2"><i>&#9993;</i><div><small>Email</small><b>hello@yourstore.com</b></div></div>
      <div class="ci2"><i>&#128205;</i><div><small>Address</small><b>Your city, Pakistan</b></div></div>
    </div>
    <form class="f cform" id="cf">
      <input id="cn" placeholder="Your name" required>
      <input id="cp" placeholder="Phone or email" required>
      <textarea id="cm" rows="4" placeholder="Your message" required></textarea>
      <button class="btn" type="submit">Send message</button>
    </form>
  </div>
</div></section>

<footer><div class="wrap">
  <div class="fgrid">
    <div><div class="logo" style="color:#fff;margin-bottom:14px"><span class="mark">L</span>Lumière</div><p>Carefully chosen pieces for everyday life. Simple shopping, honest service.</p></div>
    <div><h4>Quick links</h4><a href="#home">Home</a><a href="#about">About</a><a href="#products">Products</a><a href="#contact">Contact</a></div>
    <div><h4>Contact</h4><a href="#contact">+92 300 0000000</a><a href="#contact">hello@yourstore.com</a><a href="#contact">Your city, Pakistan</a></div>
  </div>
  <div class="fbot"><span>&copy; <span id="yr"></span> Lumière. All rights reserved.</span><a href="#admin">Admin</a></div>
</div></footer>
</div>

<!-- cart -->
<div class="ov" id="cartOv"><div class="drawer">
  <div class="row"><h3 style="font-size:1.8rem">Your cart</h3><button class="btn sm ghost" id="cartClose">Close</button></div>
  <div id="cartList"></div>
  <div class="row"><b>Total</b><b class="price" id="ct">Rs 0</b></div>
  <form class="f" id="of">
    <input id="on" placeholder="Full name" required>
    <input id="op" placeholder="Phone number" required>
    <textarea id="oa" rows="2" placeholder="Delivery address" required></textarea>
    <button class="btn" type="submit" id="ob">Place order</button>
  </form>
</div></div>

<!-- ============ ADMIN ============ -->
<div id="admin">
  <div id="loginBox" class="login"><h2>Admin login</h2>
    <input type="password" id="pw" placeholder="Admin password">
    <button class="btn" id="loginBtn">Log in</button>
    <a href="#home" style="color:var(--mute);font-size:.9rem">Back to store</a></div>
  <div id="dash" style="display:none">
    <div class="atop"><span class="logo">Lumière Admin</span><span><a href="#home" class="btn sm ghost">View store</a> <button class="btn sm" id="logout">Log out</button></span></div>
    <div class="wrap">
      <div class="tabs"><button id="tP" class="on">Products</button><button id="tO">Orders</button></div>
      <div id="pPane"><button class="btn" id="addP" style="margin-bottom:16px">Add product</button><div class="tbl"><table><thead><tr><th>Image</th><th>Name</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead><tbody id="pBody"></tbody></table></div></div>
      <div id="oPane" style="display:none"><div class="tbl"><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr></thead><tbody id="oBody"></tbody></table></div></div>
    </div>
  </div>
</div>

<!-- product modal -->
<div class="ov" id="mOv" style="align-items:center;justify-content:center"><div class="modal">
  <h3 id="mT" style="font-size:1.7rem">Product</h3>
  <input id="mName" placeholder="Product name">
  <input id="mPrice" type="number" min="0" placeholder="Price">
  <input id="mStock" type="number" min="0" placeholder="Stock quantity">
  <textarea id="mDesc" rows="2" placeholder="Description"></textarea>
  <div class="row" style="justify-content:flex-start"><div class="ph thumb" id="mPrev"></div><input type="file" id="mFile" accept="image/*"></div>
  <select id="mAct"><option value="true">Visible on store</option><option value="false">Hidden</option></select>
  <div class="row"><button class="btn ghost" id="mCancel">Cancel</button><button class="btn" id="mSave">Save product</button></div>
</div></div>
<div class="toast" id="toast"></div>

<script>
const API = "https://script.google.com/macros/s/AKfycbxTMTthmNHYKzX22d7zEJqfzJiJx1MsrrIUN-uRv3vpV0ZLXwcIzL9Lu-eW10geTSjp/exec";
const CUR = "Rs ";
const fixImg = u => { const m = String(u||"").match(/(?:\/d\/|[?&]id=)([\w-]{20,})/); return m ? "https://drive.google.com/thumbnail?id="+m[1]+"&sz=w800" : (u||""); };
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let products = [], cart = JSON.parse(sessionStorage.getItem("cart") || "[]"), adminPw = "", editing = null, newImage = "";

function toast(m){const t=$("toast");t.textContent=m;t.style.display="block";clearTimeout(t._t);t._t=setTimeout(()=>t.style.display="none",3200)}
async function post(body){
  const r = await fetch(API,{method:"POST",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(body)});
  return r.json();
}
$("yr").textContent = new Date().getFullYear();

/* ---------- STORE ---------- */
async function loadProducts(){
  $("grid").innerHTML = '<div class="sk"></div>'.repeat(6);
  try{
    const r = await (await fetch(API)).json();
    products = r.products || [];
  }catch(e){ products = []; toast("Could not load products. Check your connection."); }
  renderProducts();
}
function renderProducts(){
  if(!products.length){ $("grid").innerHTML='<p style="grid-column:1/-1;text-align:center;color:var(--mute)">No products available right now.</p>'; return; }
  $("grid").innerHTML = products.map(p=>{
    const sold = Number(p.stock) <= 0; const badge = sold ? '<span class="badge so">Sold out</span>' : (Number(p.stock) <= 5 ? '<span class="badge">Only '+esc(p.stock)+' left</span>' : "");
    return `<article class="card"><div class="ph">${p.image?`<img referrerpolicy="no-referrer" src="${esc(fixImg(p.image))}" alt="${esc(p.name)}" loading="lazy">`:"Image placeholder"}</div>
    ${badge}<div class="b"><h3>${esc(p.name)}</h3><div class="d">${esc(p.description)}</div>
    <div class="row"><span class="price">${CUR}${esc(p.price)}</span>
    ${sold?'<span class="out">Out of stock</span>':`<button class="btn sm" data-add="${esc(p.id)}">Add to cart</button>`}</div></div></article>`;
  }).join("");
}
$("grid").addEventListener("click",e=>{
  const id = e.target.dataset.add; if(!id) return;
  const p = products.find(x=>x.id===id); const it = cart.find(x=>x.id===id);
  if(it){ if(it.qty >= Number(p.stock)) return toast("No more stock available"); it.qty++; } else cart.push({id,qty:1});
  saveCart(); toast("Added to cart");
});
function saveCart(){ sessionStorage.setItem("cart",JSON.stringify(cart)); renderCart(); }
function renderCart(){
  cart = cart.filter(i=>products.find(p=>p.id===i.id));
  $("cc").textContent = cart.reduce((a,b)=>a+b.qty,0);
  let total = 0;
  $("cartList").innerHTML = cart.length ? cart.map(i=>{
    const p = products.find(x=>x.id===i.id); total += Number(p.price)*i.qty;
    return `<div class="ci"><div><b>${esc(p.name)}</b><br><small>${CUR}${esc(p.price)}</small></div>
    <div class="q row"><button data-m="${esc(i.id)}">-</button><span>${i.qty}</span><button data-p="${esc(i.id)}">+</button></div></div>`;
  }).join("") : '<p style="color:var(--mute)">Your cart is empty.</p>';
  $("ct").textContent = CUR + total;
}
$("cartList").addEventListener("click",e=>{
  const m=e.target.dataset.m, p=e.target.dataset.p;
  if(m){const it=cart.find(x=>x.id===m); it.qty--; if(it.qty<=0) cart=cart.filter(x=>x!==it);}
  if(p){const it=cart.find(x=>x.id===p), pr=products.find(x=>x.id===p); if(it.qty<Number(pr.stock)) it.qty++; else toast("No more stock available");}
  saveCart();
});
$("cartOpen").onclick = ()=>{renderCart();$("cartOv").classList.add("on")};
$("cartClose").onclick = ()=>$("cartOv").classList.remove("on");
$("cartOv").onclick = e=>{ if(e.target===$("cartOv")) $("cartOv").classList.remove("on") };
$("of").onsubmit = async e=>{
  e.preventDefault();
  if(!cart.length) return toast("Your cart is empty");
  $("ob").disabled = true; $("ob").textContent = "Placing order...";
  try{
    const r = await post({action:"placeOrder",name:$("on").value,phone:$("op").value,address:$("oa").value,items:cart});
    if(r.ok){ toast("Order placed! ID: "+r.orderId); cart=[]; saveCart(); $("of").reset(); $("cartOv").classList.remove("on"); loadProducts(); }
    else { toast(r.error || "Order failed"); loadProducts(); }
  }catch(err){ toast("Network error. Please try again."); }
  $("ob").disabled = false; $("ob").textContent = "Place order";
};
$("cf").onsubmit = e=>{ e.preventDefault(); toast("Thank you! We will get back to you soon."); $("cf").reset(); };

/* ---------- ADMIN ---------- */
function route(){
  const isAdmin = location.hash === "#admin";
  $("admin").style.display = isAdmin ? "block" : "none";
  $("store").style.display = isAdmin ? "none" : "block";
  if(isAdmin) window.scrollTo(0,0);
}
window.addEventListener("hashchange",route); route();

$("loginBtn").onclick = async ()=>{
  const pw = $("pw").value;
  try{
    const r = await post({action:"login",password:pw});
    if(!r.ok) return toast(r.error || "Wrong password");
    adminPw = pw; $("loginBox").style.display="none"; $("dash").style.display="block"; loadAdmin();
  }catch(e){ toast("Network error"); }
};
$("pw").addEventListener("keydown",e=>{ if(e.key==="Enter") $("loginBtn").click(); });
$("logout").onclick = ()=>{ adminPw=""; $("dash").style.display="none"; $("loginBox").style.display="grid"; $("pw").value=""; };
$("tP").onclick = ()=>tab("P"); $("tO").onclick = ()=>tab("O");
function tab(t){
  $("pPane").style.display = t==="P"?"block":"none"; $("oPane").style.display = t==="O"?"block":"none";
  $("tP").classList.toggle("on",t==="P"); $("tO").classList.toggle("on",t==="O");
}
async function loadAdmin(){
  const [p,o] = await Promise.all([post({action:"adminProducts",password:adminPw}), post({action:"orders",password:adminPw})]);
  window._ap = p.products || [];
  $("pBody").innerHTML = window._ap.map(x=>`<tr><td>${x.image?`<img referrerpolicy="no-referrer" src="${esc(fixImg(x.image))}" alt="">`:'<div class="ph thumb"></div>'}</td>
    <td><b>${esc(x.name)}</b></td><td>${CUR}${esc(x.price)}</td><td>${esc(x.stock)}</td>
    <td>${(x.active===true||x.active==="TRUE")?"Visible":"Hidden"}</td>
    <td style="white-space:nowrap"><button class="btn sm ghost" data-e="${esc(x.id)}">Edit</button> <button class="btn sm danger" data-d="${esc(x.id)}">Delete</button></td></tr>`).join("")
    || '<tr><td colspan="6">No products yet.</td></tr>';
  $("oBody").innerHTML = (o.orders||[]).map(x=>`<tr><td><b>${esc(x.orderId)}</b><br><small>${esc(new Date(x.date).toLocaleString())}</small></td>
    <td>${esc(x.name)}<br><small>${esc(x.phone)}<br>${esc(x.address)}</small></td><td>${esc(x.items)}</td><td>${CUR}${esc(x.total)}</td>
    <td><select data-o="${esc(x._row)}">${["Pending","Confirmed","Shipped","Delivered","Cancelled"].map(s=>`<option ${s===x.status?"selected":""}>${s}</option>`).join("")}</select></td></tr>`).join("")
    || '<tr><td colspan="5">No orders yet.</td></tr>';
}
$("oBody").addEventListener("change",async e=>{
  const row = e.target.dataset.o; if(!row) return;
  const r = await post({action:"orderStatus",password:adminPw,row:Number(row),status:e.target.value});
  toast(r.ok ? "Status updated" : r.error);
});
$("pBody").addEventListener("click",async e=>{
  const eid=e.target.dataset.e, did=e.target.dataset.d;
  if(eid) openModal(window._ap.find(x=>x.id===eid));
  if(did && confirm("Delete this product permanently?")){
    const r = await post({action:"deleteProduct",password:adminPw,id:did});
    toast(r.ok ? "Product deleted" : r.error); loadAdmin();
  }
});
$("addP").onclick = ()=>openModal(null);
function openModal(p){
  editing = p; newImage = p ? (p.image||"") : "";
  $("mT").textContent = p ? "Edit product" : "Add product";
  $("mName").value = p?p.name:""; $("mPrice").value = p?p.price:""; $("mStock").value = p?p.stock:"";
  $("mDesc").value = p?p.description:""; $("mAct").value = p ? String(p.active===true||p.active==="TRUE") : "true";
  $("mFile").value = ""; showPrev(); $("mOv").classList.add("on");
}
function showPrev(){ $("mPrev").innerHTML = newImage ? `<img referrerpolicy="no-referrer" src="${esc(fixImg(newImage))}" alt="">` : ""; }
$("mCancel").onclick = ()=>$("mOv").classList.remove("on");
$("mFile").onchange = e=>{
  const f = e.target.files[0]; if(!f) return;
  const img = new Image(), rd = new FileReader();
  rd.onload = ()=>{ img.src = rd.result; };
  img.onload = async ()=>{
    const s = Math.min(1, 800/Math.max(img.width,img.height));
    const c = document.createElement("canvas"); c.width = img.width*s; c.height = img.height*s;
    c.getContext("2d").drawImage(img,0,0,c.width,c.height);
    const data = c.toDataURL("image/jpeg",0.82).split(",")[1];
    toast("Uploading image...");
    try{
      const r = await post({action:"uploadImage",password:adminPw,data,mime:"image/jpeg",filename:"product-"+Date.now()+".jpg"});
      if(r.ok){ newImage = r.url; showPrev(); toast("Image uploaded"); } else toast(r.error || "Upload failed");
    }catch(err){ toast("Upload failed"); }
  };
  rd.readAsDataURL(f);
};
$("mSave").onclick = async ()=>{
  if(!$("mName").value.trim()) return toast("Enter a product name");
  const product = {id:editing?editing.id:"",name:$("mName").value.trim(),price:Number($("mPrice").value)||0,stock:Number($("mStock").value)||0,
    image:newImage,description:$("mDesc").value.trim(),active:$("mAct").value==="true"};
  const r = await post({action:"saveProduct",password:adminPw,product});
  if(r.ok){ toast("Product saved"); $("mOv").classList.remove("on"); loadAdmin(); } else toast(r.error || "Save failed");
};

loadProducts(); renderCart();
(function(){
  const hd=document.querySelector("header");
  addEventListener("scroll",()=>hd.classList.toggle("sc",scrollY>10),{passive:true});
  const secs=[...document.querySelectorAll("section[id]")], ls=[...document.querySelectorAll(".links a[href^='#']")];
  addEventListener("scroll",()=>{let c="home";secs.forEach(x=>{if(x.getBoundingClientRect().top<140)c=x.id});ls.forEach(a=>a.classList.toggle("act",a.getAttribute("href")==="#"+c))},{passive:true});
  if("IntersectionObserver" in window){
    const io=new IntersectionObserver(en=>en.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}}),{threshold:.12});
    document.querySelectorAll(".title,.about .wrap>*,.cgrid>*,.trust .ti,.hero .wrap>*").forEach(x=>{x.classList.add("rv");io.observe(x)});
  }
})();
</script>
